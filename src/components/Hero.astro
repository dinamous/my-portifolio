---
const firstName = "Matheus".split("");
const lastName = "Simões".split("");
---

<section class="hero" id="hero-section">
  <div class="hero__aurora" id="hero-aurora" aria-hidden="true"></div>

  <div class="hero__scan" id="hero-scan" aria-hidden="true"></div>

  <div class="hero__type" id="hero-type" aria-hidden="true"></div>

  <div class="hero__bottom">
    <h1 class="hero__row" id="hero-row">
      <span class="hero__word hero__word--first" id="hero-word-1">
        {firstName.map((ch) => (
          <span class="hero__letter-wrap"><span class="hero__letter">{ch}</span></span>
        ))}
      </span>
      <span class="hero__word hero__word--last" id="hero-word-2">
        {lastName.map((ch) => (
          <span class="hero__letter-wrap"><span class="hero__letter">{ch}</span></span>
        ))}<span class="hero__semi" id="hero-semi">;</span>
      </span>
    </h1>

    <div class="hero__bar" id="hero-bar" aria-hidden="true"></div>

    <!-- ponytail: LinkedIn/GitHub hrefs are placeholders, swap in real profile URLs -->
    <nav class="hero__nav" id="hero-nav" aria-label="Navegação principal">
      <ul class="hero__nav-social">
        <li><a href="#" target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href="#" target="_blank" rel="noopener">GitHub</a></li>
        <li><a href="mailto:dinamous.dev@gmail.com">Email</a></li>
      </ul>
      <ul class="hero__nav-pages">
        <li><a href="#sobre">Sobre</a></li>
        <li><a href="#trabalhos">Trabalhos</a></li>
        <li><a href="#contato">Contato</a></li>
      </ul>
    </nav>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    background: #000;
    overflow: hidden;
  }

  .hero__scan {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 100vh;
    background: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
    z-index: 2;
    transform: translateY(100vh);
  }

  .hero__type {
    position: absolute;
    top: 6vh;
    left: 5vw;
    z-index: 1;
    max-width: 34ch;
    min-height: 3.1em;
    color: #d1d5db;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 500;
    font-size: clamp(0.75rem, 0.95vw, 0.85rem);
    line-height: 1.55;
    opacity: 0;
    visibility: hidden;
  }

  :global(.hero__type-em) {
    font-family: "Cormorant Infant", serif;
    font-style: italic;
    font-weight: 500;
    font-size: 1.2em;
    color: #fff;
  }

  :global(.hero__type-cursor) {
    display: inline-block;
    margin-left: 1px;
    animation: hero-type-blink 0.9s steps(1) infinite;
  }

  @keyframes hero-type-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.hero__type-cursor) {
      animation: none;
    }
  }

  .hero__aurora {
    position: absolute;
    top: -10%;
    left: 0;
    right: 0;
    height: 120%;
    z-index: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .hero__bottom {
    position: absolute;
    inset: auto 0 4vh 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  .hero__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    width: 100%;
    padding-inline: 5vw;
    margin: 0;
  }

  .hero__word {
    --hero-size: clamp(3rem, 13vw, 11rem);
    display: inline-flex;
    color: #fff;
    line-height: 1;
    white-space: nowrap;
    font-size: var(--hero-size);
  }

  .hero__word--first {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .hero__word--last {
    font-family: "Cormorant Infant", serif;
    font-style: italic;
    font-weight: 500;
    /* Cormorant Infant's x-height runs much smaller than Space Grotesk at the same font-size */
    font-size: calc(var(--hero-size) * 1.3);
  }

  .hero__letter-wrap {
    display: inline-block;
    overflow: hidden;
    line-height: 1;
    padding-right: 0.06em;
    margin-right: -0.06em;
  }

  .hero__letter {
    display: inline-block;
    transform: translateY(110%);
    opacity: 0;
    will-change: transform, opacity;
  }

  .hero__semi {
    display: inline-block;
    color: #6b7280;
    opacity: 0;
    transform: scale(0.4);
    will-change: transform, opacity;
  }

  .hero__bar {
    width: calc(100% - 10vw);
    height: 3px;
    margin: 80px auto 0;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.4) 25%,
      rgba(255, 255, 255, 0.4) 75%,
      transparent
    );
    transform: scaleX(0);
    transform-origin: center;
    opacity: 0;
  }

  .hero__nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
    padding-inline: 5vw;
    margin-top: 1.1rem;
    gap: 0.75rem;
  }

  .hero__nav-social {
    grid-column: 2;
    justify-self: center;
  }

  .hero__nav-pages {
    grid-column: 3;
    justify-self: end;
  }

  .hero__nav-social,
  .hero__nav-pages {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero__nav-social li,
  .hero__nav-pages li {
    opacity: 0;
    transform: translateY(10px);
  }

  .hero__nav-social li:not(:first-child)::before,
  .hero__nav-pages li:not(:first-child)::before {
    content: "/";
    display: inline-block;
    margin-right: 1rem;
    color: #4b5563;
    font-weight: 400;
  }

  .hero__nav a {
    position: relative;
    display: inline-block;
    padding-bottom: 1px;
    color: #6b7280;
    text-transform: uppercase;
    text-decoration: none;
    font-size: clamp(0.75rem, 1.3vw, 0.9rem);
    font-weight: 700;
    letter-spacing: 0.16em;
    transition: color 0.25s ease;
  }

  .hero__nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1px;
    background: #d1d5db;
    transition: width 0.3s ease;
  }

  .hero__nav a:hover,
  .hero__nav a:focus-visible {
    color: #e5e7eb;
  }

  .hero__nav a:hover::after,
  .hero__nav a:focus-visible::after {
    width: 100%;
  }

  @media (max-width: 640px) {
    .hero__type {
      max-width: 70vw;
      min-height: 4.65em;
      top: 4vh;
    }

    .hero__bottom {
      inset: auto 0 3vh 0;
    }

    .hero__row {
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    .hero__bar {
      margin-top: 48px;
    }

    .hero__nav {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0.9rem;
      margin-top: 0.9rem;
    }

    .hero__nav-social,
    .hero__nav-pages {
      grid-column: 1;
      justify-self: center;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { createDarkVeil } from "./dark-veil";
  import { getSmoother } from "../lib/smoother";
  import { startTextType } from "../lib/textType";

  const heroTypePhrases = [
    "Dev de poucas palavras, interfaces que falam por si. Vida em cada *transição*.",
    "Criador silencioso no *front* das ideias, dando vida com movimento e suavidade.",
    "Calmo por fora, *keyframes* por dentro. Detalhes que ninguém nota, mas todo mundo sente.",
  ];

  const heroSection = document.getElementById("hero-section")!;
  const row = document.getElementById("hero-row")!;
  const word1 = document.getElementById("hero-word-1")!;
  const word2 = document.getElementById("hero-word-2")!;
  const words = [word1, word2];
  const semi = document.getElementById("hero-semi")!;
  const scan = document.getElementById("hero-scan")!;
  const bar = document.getElementById("hero-bar")!;
  const aurora = document.getElementById("hero-aurora")!;
  const heroType = document.getElementById("hero-type")!;
  createDarkVeil(aurora, {
    hueShift: 50,
    noiseIntensity: 0.09,
    scanlineIntensity: 0.43,
    speed: 0.8,
    scanlineFrequency: 1.3,
    warpAmount: 0.3,
  });
  const navItems = Array.from(
    document.querySelectorAll<HTMLElement>("#hero-nav li"),
  );

  // ponytail: scroll stays locked until the nav finishes revealing, via the
  // shared ScrollSmoother instance rather than body overflow (which the
  // smoother already manages).
  const smoother = getSmoother();
  smoother.paused(true);
  const unlockScroll = () => {
    smoother.paused(false);
  };

  const word1Letters = Array.from(
    document.querySelectorAll<HTMLElement>("#hero-word-1 .hero__letter"),
  ).reverse();
  const word2Letters = Array.from(
    document.querySelectorAll<HTMLElement>("#hero-word-2 .hero__letter"),
  );

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (reduceMotion) {
    gsap.set([...word1Letters, ...word2Letters], { y: 0, opacity: 1 });
    gsap.set(semi, { opacity: 1, scale: 1 });
    gsap.set(scan, { autoAlpha: 0 });
    gsap.set(bar, { scaleX: 1, opacity: 1 });
    gsap.set(navItems, { y: 0, opacity: 1 });
    gsap.set(aurora, { autoAlpha: 1 });
    gsap.set(heroType, { autoAlpha: 1 });
    startTextType(heroType, heroTypePhrases);
    unlockScroll();
  } else {
    const isColumn = getComputedStyle(row).flexDirection === "column";
    const mainAxis = isColumn ? "y" : "x";
    const tightGap = 48; // px between the two words while centered

    const rowRect = row.getBoundingClientRect();
    const rowCenterX = rowRect.left + rowRect.width / 2;
    const rowCenterY = rowRect.top + rowRect.height / 2;
    const pivot = isColumn ? rowCenterY : rowCenterX;

    const rects = words.map((w) => w.getBoundingClientRect());
    const sizes = rects.map((r) => (isColumn ? r.height : r.width));
    const centers = rects.map((r) =>
      isColumn ? r.top + r.height / 2 : r.left + r.width / 2,
    );
    const wordDeltas = words.map((_, i) => {
      const side = i === 0 ? -1 : 1;
      const targetCenter = pivot + side * (tightGap / 2 + sizes[i] / 2);
      return targetCenter - centers[i];
    });

    gsap.set(row, { y: window.innerHeight / 2 - rowCenterY });
    words.forEach((w, i) =>
      gsap.set(w, { [mainAxis]: wordDeltas[i], scale: 0.8 }),
    );

    const scanHeight = scan.offsetHeight;
    gsap.set(scan, { y: heroSection.offsetHeight });

    gsap
      .timeline({ defaults: { ease: "power3.out" } })
      .to(word1Letters, { y: "0%", opacity: 1, duration: 1.1, stagger: 0.09 }, 0)
      .to(word2Letters, { y: "0%", opacity: 1, duration: 1.1, stagger: 0.09 }, 0)
      .to(semi, { opacity: 1, scale: 1, duration: 0.35, ease: "back.out(3)" }, "+=0.15")
      .to(
        words,
        { x: 0, y: 0, scale: 1, duration: 1.1, stagger: 0.12, ease: "power3.inOut" },
        "+=0.3",
      )
      .to(row, { y: 0, duration: 1.1, ease: "power3.inOut" }, "<")
      .to(scan, { y: -scanHeight, duration: 2.4, ease: "power2.inOut" }, "-=0.35")
      .to(aurora, { autoAlpha: 1, duration: 0.7, ease: "power2.in" }, "-=1.8")
      .to(heroType, { autoAlpha: 1, duration: 0.6, ease: "power2.out" }, "<")
      .call(() => startTextType(heroType, heroTypePhrases))
      .to(bar, { scaleX: 1, opacity: 1, duration: 0.7, ease: "power3.inOut" }, "+=0.15")
      .to(navItems, { y: 0, opacity: 1, duration: 0.6, stagger: 0.22, ease: "power3.out" }, "+=0.1")
      .call(unlockScroll);
  }
</script>
