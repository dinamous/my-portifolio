{/* ponytail: placeholder copy, swap in real content */}
<section
  class="whatido fixed inset-0 h-screen w-screen"
  id="whatido-section"
  data-stack
  data-no-close-clip
>
  <div class="whatido__inner">
    <div class="whatido__col whatido__col--left" id="whatido-col-left">
      <div class="whatido__meta">
        <span class="whatido__meta-item">Conceito</span>
        <span class="whatido__meta-item">01 / Estrutura</span>
      </div>
      <h2 class="whatido__title">Arquitetura</h2>
      <div class="whatido__divider" aria-hidden="true"></div>
      <p class="whatido__text">
        Desenvolvimento modular, limpo e de alta performance. Layouts
        responsivos com foco na acessibilidade e semântica web. Codificação
        robusta para experiências estáveis.
      </p>
    </div>

    <div class="whatido__col whatido__col--right" id="whatido-col-right">
      <div class="whatido__meta">
        <span class="whatido__meta-item">Execução</span>
        <span class="whatido__meta-item">02 / Movimento</span>
      </div>
      <h2 class="whatido__title">Experiência</h2>
      <div class="whatido__divider" aria-hidden="true"></div>
      <p class="whatido__text">
        Transições fluidas e micro-interações elegantes que dão vida à
        interface. Criação de experiências imersivas e jornadas do usuário
        cativantes através do movimento.
      </p>
    </div>
  </div>
</section>

<style>
  .whatido {
    background: #f2f0ef;
    display: flex;
    align-items: center;
    clip-path: inset(0% 0% 0% 0%);
    will-change: clip-path;
  }

  .whatido__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4vw;
    width: 100%;
    padding: 0 6vw;
  }

  .whatido__col {
    max-width: 26vw;
    will-change: transform, opacity;
  }

  .whatido__col--right {
    text-align: right;
  }

  .whatido__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid #e5e7eb;
    color: #6b7280;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: clamp(0.65rem, 0.9vw, 0.75rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .whatido__title {
    margin: 0 0 1.5rem;
    font-family: "Cormorant Infant", serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(2.6rem, 5.2vw, 5.5rem);
    line-height: 1;
    white-space: nowrap;
    background: linear-gradient(100deg, #0891b2, #10b981);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .whatido__divider {
    height: 1px;
    margin-bottom: 1.5rem;
    background: #d1d5db;
    transform: scaleX(0);
    transform-origin: left center;
  }

  .whatido__col--right .whatido__divider {
    transform-origin: right center;
  }

  .whatido__text {
    max-width: 42ch;
    margin: 0;
    margin-left: auto;
    color: #374151;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 500;
    font-size: clamp(0.9rem, 1.2vw, 1.05rem);
    line-height: 1.6;
  }

  .whatido__col--left .whatido__text {
    margin-left: 0;
  }

  @media (max-width: 900px) {
    .whatido__col {
      max-width: 40vw;
    }

    .whatido__title {
      font-size: clamp(2rem, 6vw, 3rem);
    }
  }

  @media (max-width: 640px) {
    .whatido {
      align-items: flex-start;
      padding: 10vh 0;
      overflow-y: auto;
    }

    .whatido__inner {
      flex-direction: column;
      gap: 8vh;
      padding: 0 8vw;
    }

    .whatido__col,
    .whatido__col--right {
      max-width: 100%;
      text-align: left;
    }

    .whatido__title {
      white-space: normal;
    }

    .whatido__text,
    .whatido__col--left .whatido__text {
      margin-left: 0;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { CLIP_CLOSE_T } from "../lib/sectionStack";

  const section = document.getElementById("whatido-section")!;
  const colLeft = document.getElementById("whatido-col-left")!;
  const colRight = document.getElementById("whatido-col-right")!;
  const cols = [colLeft, colRight];

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (reduceMotion) {
    gsap.set(cols, { x: 0, opacity: 1 });
  } else {
    gsap.set(colLeft, { x: "-3vw", opacity: 0 });
    gsap.set(colRight, { x: "3vw", opacity: 0 });

    // scroll-driven: columns fade in and slide toward center as the hero bar
    // closes, then keep pulling further toward center once it starts spinning
    // (see Hero.astro's spinT, same CLIP_CLOSE_T threshold).
    window.addEventListener("hero:bar-shrink", ((
      e: CustomEvent<{ progress: number }>,
    ) => {
      const t = e.detail.progress;

      const colsT = gsap.utils.clamp(0, 1, t / 0.35);
      gsap.set(colLeft, {
        x: gsap.utils.interpolate("-3vw", "-4vw", colsT),
        opacity: colsT,
      });
      gsap.set(colRight, {
        x: gsap.utils.interpolate("3vw", "4vw", colsT),
        opacity: colsT,
      });

      const spinT = gsap.utils.clamp(
        0,
        1,
        (t - CLIP_CLOSE_T) / (1 - CLIP_CLOSE_T),
      );
      gsap.set(colLeft, { x: gsap.utils.interpolate("-4vw", "8vw", spinT) });
      gsap.set(colRight, { x: gsap.utils.interpolate("4vw", "-8vw", spinT) });
    }) as EventListener);

    // rebroadcasts this section's own closing progress on window, same as Hero does
    // with hero:bar-shrink, so the next stacked section (AboutMe) can react to it
    // without reaching into this section's DOM directly.
    section.addEventListener("stack:progress", ((
      e: CustomEvent<{ progress: number }>,
    ) => {
      const t = e.detail.progress;
      window.dispatchEvent(
        new CustomEvent("whatido:progress", { detail: { progress: t } }),
      );
    }) as EventListener);
  }
</script>
