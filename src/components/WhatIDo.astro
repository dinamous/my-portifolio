---
// ponytail: placeholder copy, swap in real content
const leftTitle = "Arquitetura".split("");
const leftText =
  "Desenvolvimento modular, limpo e de alta performance. Layouts responsivos com foco na acessibilidade e semântica web. Codificação robusta para experiências estáveis.".split(
    " ",
  );
const rightTitle = "Experiência".split("");
const rightText =
  "Transições fluidas e micro-interações elegantes que dão vida à interface. Criação de experiências imersivas e jornadas do usuário cativantes através do movimento.".split(
    " ",
  );
---

<section class="whatido fixed inset-0 h-screen w-screen" id="whatido-section" data-stack data-no-close-clip>
  <div class="whatido__inner">
    <div class="whatido__col whatido__col--left" id="whatido-col-left">
      <div class="whatido__meta" id="whatido-meta-left">
        <span class="whatido__meta-item">Conceito</span>
        <span class="whatido__meta-item">01 / Estrutura</span>
      </div>
      <h2 class="whatido__title" id="whatido-title-left">
        {leftTitle.map((ch) => (
          <span class="whatido__letter-wrap"><span class="whatido__letter">{ch}</span></span>
        ))}
      </h2>
      <div class="whatido__divider" aria-hidden="true"></div>
      <p class="whatido__text" id="whatido-text-left">
        {leftText.map((word, i) => (
          <Fragment>
            <span class="whatido__word-wrap"><span class="whatido__word">{word}</span></span>
            {i < leftText.length - 1 ? " " : ""}
          </Fragment>
        ))}
      </p>
    </div>

    <div class="whatido__col whatido__col--right" id="whatido-col-right">
      <div class="whatido__meta" id="whatido-meta-right">
        <span class="whatido__meta-item">Execução</span>
        <span class="whatido__meta-item">02 / Movimento</span>
      </div>
      <h2 class="whatido__title" id="whatido-title-right">
        {rightTitle.map((ch) => (
          <span class="whatido__letter-wrap"><span class="whatido__letter">{ch}</span></span>
        ))}
      </h2>
      <div class="whatido__divider" aria-hidden="true"></div>
      <p class="whatido__text" id="whatido-text-right">
        {rightText.map((word, i) => (
          <Fragment>
            <span class="whatido__word-wrap"><span class="whatido__word">{word}</span></span>
            {i < rightText.length - 1 ? " " : ""}
          </Fragment>
        ))}
      </p>
    </div>
  </div>
</section>

<style>
  .whatido {
    background: #f2f0ef;
    display: flex;
    align-items: center;
    clip-path: inset(0% 0% 0% 0%);
    will-change: clip-path;
  }

  .whatido__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4vw;
    width: 100%;
    padding: 0 6vw;
  }

  .whatido__col {
    max-width: 26vw;
    will-change: transform, opacity;
  }

  .whatido__col--right {
    text-align: right;
  }

  .whatido__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid #e5e7eb;
    color: #6b7280;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: clamp(0.65rem, 0.9vw, 0.75rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .whatido__title {
    margin: 0 0 1.5rem;
    font-family: "Cormorant Infant", serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(2.6rem, 5.2vw, 5.5rem);
    line-height: 1;
    white-space: nowrap;
  }

  .whatido__letter-wrap {
    display: inline-block;
    overflow: hidden;
    line-height: 1;
    perspective: 400px;
  }

  .whatido__letter {
    display: inline-block;
    /* ponytail: background-size/position set inline per letter (see script) so the
       gradient reads as one continuous sweep across the whole word instead of each
       letter rendering its own isolated copy of it */
    background: linear-gradient(100deg, #0891b2, #10b981);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    will-change: transform, opacity;
  }

  .whatido__word-wrap {
    display: inline-block;
    overflow: hidden;
    line-height: 1.6;
  }

  .whatido__word {
    display: inline-block;
    will-change: transform, opacity;
  }

  .whatido__meta-item {
    display: inline-block;
    will-change: transform, opacity;
  }

  .whatido__divider {
    height: 1px;
    margin-bottom: 1.5rem;
    background: #d1d5db;
    transform: scaleX(0);
    transform-origin: left center;
  }

  .whatido__col--right .whatido__divider {
    transform-origin: right center;
  }

  .whatido__text {
    max-width: 42ch;
    margin: 0;
    margin-left: auto;
    color: #374151;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 500;
    font-size: clamp(0.9rem, 1.2vw, 1.05rem);
    line-height: 1.6;
  }

  .whatido__col--left .whatido__text {
    margin-left: 0;
  }

  @media (max-width: 900px) {
    .whatido__col {
      max-width: 40vw;
    }

    .whatido__title {
      font-size: clamp(2rem, 6vw, 3rem);
    }
  }

  @media (max-width: 640px) {
    .whatido {
      align-items: flex-start;
      padding: 10vh 0;
      overflow-y: auto;
    }

    .whatido__inner {
      flex-direction: column;
      gap: 8vh;
      padding: 0 8vw;
    }

    .whatido__col,
    .whatido__col--right {
      max-width: 100%;
      text-align: left;
    }

    .whatido__title {
      white-space: normal;
    }

    .whatido__text,
    .whatido__col--left .whatido__text {
      margin-left: 0;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { CLIP_CLOSE_T } from "../lib/sectionStack";

  const section = document.getElementById("whatido-section")!;
  const colLeft = document.getElementById("whatido-col-left")!;
  const colRight = document.getElementById("whatido-col-right")!;
  const cols = [colLeft, colRight];

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  // the title's gradient lives per-letter (see .whatido__letter CSS) so each
  // letter can animate independently — this stretches one shared background
  // across the full title width and offsets each letter to its own slice, so
  // it still reads as a single continuous cyan->emerald sweep across the word
  function layoutTitleGradient(titleEl: HTMLElement) {
    const totalWidth = titleEl.offsetWidth;
    titleEl
      .querySelectorAll<HTMLElement>(".whatido__letter")
      .forEach((letter) => {
        const offset = letter.getBoundingClientRect().left - titleEl.getBoundingClientRect().left;
        letter.style.backgroundSize = `${totalWidth}px 100%`;
        letter.style.backgroundPosition = `${-offset}px 0`;
      });
  }

  // builds a paused timeline for one column: meta -> title (letter by letter)
  // -> paragraph (word by word), each phase starting slightly before the
  // previous one finishes so the reveal reads continuous rather than stepped.
  // Letters get a subtle 3D flip-up (rotateX) instead of a plain slide, and an
  // elastic-leaning ease on the title gives the reveal more character than a
  // generic power-out would.
  function buildRevealTimeline(colId: string, titleId: string) {
    const col = document.getElementById(colId)!;
    const titleEl = document.getElementById(titleId)!;
    layoutTitleGradient(titleEl);

    const meta = col.querySelectorAll<HTMLElement>(".whatido__meta-item");
    const letters = titleEl.querySelectorAll<HTMLElement>(".whatido__letter");
    const words = col.querySelectorAll<HTMLElement>(".whatido__word");

    gsap.set(col.querySelectorAll(".whatido__letter-wrap, .whatido__word-wrap"), {
      transformPerspective: 400,
    });
    gsap.set(meta, { y: 12, opacity: 0 });
    gsap.set(letters, { yPercent: 115, rotateX: -50, opacity: 0, transformOrigin: "50% 100%" });
    gsap.set(words, { yPercent: 60, opacity: 0 });

    return gsap
      .timeline({ paused: true })
      .to(letters, {
        yPercent: 0,
        rotateX: 0,
        opacity: 1,
        duration: 0.75,
        stagger: 0.028,
        ease: "back.out(1.7)",
      })
      .to(
        meta,
        { y: 0, opacity: 1, duration: 0.45, stagger: 0.07, ease: "power3.out" },
        "-=0.35",
      )
      .to(
        words,
        { yPercent: 0, opacity: 1, duration: 0.5, stagger: 0.04, ease: "power2.out" },
        "-=0.2",
      );
  }

  if (reduceMotion) {
    gsap.set(cols, { x: 0, opacity: 1 });
    gsap.set(section.querySelectorAll(".whatido__meta-item, .whatido__letter, .whatido__word"), {
      y: 0,
      opacity: 1,
    });
  } else {
    gsap.set(colLeft, { x: "-3vw", opacity: 0 });
    gsap.set(colRight, { x: "3vw", opacity: 0 });

    const revealLeft = buildRevealTimeline("whatido-col-left", "whatido-title-left");
    const revealRight = buildRevealTimeline("whatido-col-right", "whatido-title-right").delay(0.15);
    let revealed = false;

    window.addEventListener("hero:bar-shrink", ((
      e: CustomEvent<{ progress: number }>,
    ) => {
      const t = e.detail.progress;
      const shouldReveal = t >= CLIP_CLOSE_T;
      if (shouldReveal !== revealed) {
        revealed = shouldReveal;
        if (revealed) {
          revealLeft.play();
          revealRight.play();
        } else {
          revealLeft.reverse();
          revealRight.reverse();
        }
      }
    }) as EventListener);

    // scroll-driven: columns fade in and slide toward center as the hero bar
    // closes, then keep pulling further toward center once it starts spinning
    // (see Hero.astro's spinT, same CLIP_CLOSE_T threshold).
    window.addEventListener("hero:bar-shrink", ((
      e: CustomEvent<{ progress: number }>,
    ) => {
      const t = e.detail.progress;

      const colsT = gsap.utils.clamp(0, 1, t / 0.35);
      gsap.set(colLeft, {
        x: gsap.utils.interpolate("-3vw", "-4vw", colsT),
        opacity: colsT,
      });
      gsap.set(colRight, {
        x: gsap.utils.interpolate("3vw", "4vw", colsT),
        opacity: colsT,
      });

      const spinT = gsap.utils.clamp(
        0,
        1,
        (t - CLIP_CLOSE_T) / (1 - CLIP_CLOSE_T),
      );
      gsap.set(colLeft, { x: gsap.utils.interpolate("-4vw", "8vw", spinT) });
      gsap.set(colRight, { x: gsap.utils.interpolate("4vw", "-8vw", spinT) });
    }) as EventListener);

    // rebroadcasts this section's own closing progress on window, same as Hero does
    // with hero:bar-shrink, so the next stacked section (AboutMe) can react to it
    // without reaching into this section's DOM directly.
    section.addEventListener("stack:progress", ((
      e: CustomEvent<{ progress: number }>,
    ) => {
      const t = e.detail.progress;
      window.dispatchEvent(
        new CustomEvent("whatido:progress", { detail: { progress: t } }),
      );
    }) as EventListener);
  }
</script>
