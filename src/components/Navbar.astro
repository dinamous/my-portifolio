{/* ponytail: LinkedIn/GitHub hrefs are placeholders, swap in real profile URLs */}
<div class="navbar">
  <div class="navbar__bar" id="navbar-bar" aria-hidden="true"></div>
  <nav class="navbar__nav" aria-label="Navegação principal">
    <span class="navbar__brand">@dinamous</span>
    <ul class="navbar__social">
      <li><a href="#" target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a href="#" target="_blank" rel="noopener">GitHub</a></li>
      <li><a href="mailto:dinamous.dev@gmail.com">Email</a></li>
    </ul>
    <ul class="navbar__pages">
      <li><a href="#aboutme-section">Sobre</a></li>
      <li><a href="#projects-section">Trabalhos</a></li>
      <li><a href="#skills-section">Skills</a></li>
      <li><a href="#contact-section">Contato</a></li>
    </ul>
  </nav>
</div>

<style>
  /* ponytail: position:absolute (not fixed) matches every other hero child
     (.hero__aurora/scan/type/bottom) — it keeps the navbar inside the
     hero's own clip-path/containing-block context, so the section's
     closing wipe clips it in sync with the rest instead of a fixed
     element sailing past the clip and only vanishing at the final
     visibility:hidden snap */
  .navbar {
    position: absolute;
    inset: auto 0 4vh 0;
    z-index: 10;
    mix-blend-mode: difference;
    pointer-events: none;
  }

  .navbar__nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
    padding-inline: 5vw;
    gap: 0.75rem;
    pointer-events: auto;
  }

  .navbar__bar {
    width: calc(100% - 10vw);
    height: 3px;
    margin: 0 auto 1.1rem;
    background: linear-gradient(
      90deg,
      transparent,
      #fff 25%,
      #fff 75%,
      transparent
    );
    transform: scaleX(0);
    transform-origin: center;
    opacity: 0;
  }

  .navbar__brand {
    grid-column: 1;
    justify-self: start;
    color: #fff;
    opacity: 0.7;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: clamp(0.85rem, 1.5vw, 1.05rem);
    letter-spacing: 0.02em;
  }

  .navbar__social {
    grid-column: 2;
    justify-self: center;
  }

  .navbar__pages {
    grid-column: 3;
    justify-self: end;
  }

  .navbar__brand,
  .navbar__social li,
  .navbar__pages li {
    opacity: 0;
    transform: translateY(10px);
  }

  .navbar__social,
  .navbar__pages {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .navbar__social li:not(:first-child)::before,
  .navbar__pages li:not(:first-child)::before {
    content: "/";
    display: inline-block;
    margin-right: 1rem;
    color: #fff;
    opacity: 0.6;
    font-weight: 400;
  }

  .navbar__nav a {
    position: relative;
    display: inline-block;
    padding-bottom: 1px;
    color: #fff;
    opacity: 0.7;
    text-transform: uppercase;
    text-decoration: none;
    font-size: clamp(0.75rem, 1.3vw, 0.9rem);
    font-weight: 700;
    letter-spacing: 0.16em;
    transition: opacity 0.25s ease;
  }

  .navbar__nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1px;
    background: #fff;
    transition: width 0.3s ease;
  }

  .navbar__nav a:hover,
  .navbar__nav a:focus-visible {
    opacity: 1;
  }

  .navbar__nav a:hover::after,
  .navbar__nav a:focus-visible::after {
    width: 100%;
  }

  @media (max-width: 640px) {
    .navbar {
      inset: auto 0 3vh 0;
    }

    .navbar__nav {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0.9rem;
    }

    .navbar__brand,
    .navbar__social,
    .navbar__pages {
      grid-column: 1;
      justify-self: center;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { goToSection } from "../lib/sectionStack";

  const bar = document.getElementById("navbar-bar")!;
  const items = Array.from(
    document.querySelectorAll<HTMLElement>(
      ".navbar__brand, .navbar__social li, .navbar__pages li",
    ),
  );

  document.querySelectorAll<HTMLAnchorElement>(".navbar__pages a").forEach((a) => {
    a.addEventListener("click", (e) => {
      e.preventDefault();
      goToSection(a.getAttribute("href")!.slice(1));
    });
  });

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (reduceMotion) {
    gsap.set(bar, { scaleX: 1, opacity: 1 });
    gsap.set(items, { y: 0, opacity: 1 });
  } else {
    window.addEventListener(
      "hero:reveal-nav",
      () => {
        gsap
          .timeline({ defaults: { ease: "power3.out" } })
          .to(bar, { scaleX: 1, opacity: 1, duration: 0.7, ease: "power3.inOut" })
          .to(items, { y: 0, opacity: 1, duration: 0.6, stagger: 0.22, ease: "power3.out" }, "+=0.1")
          .call(() => window.dispatchEvent(new CustomEvent("navbar:revealed")));
      },
      { once: true },
    );
  }

  // recedes together with the section it lives in, same treatment as the hero's own content
  const navbar = document.querySelector<HTMLElement>(".navbar")!;
  navbar.closest("[data-stack]")?.addEventListener("stack:progress", ((
    e: CustomEvent<{ progress: number }>,
  ) => {
    const p = e.detail.progress;
    gsap.set(navbar, { y: p * 40, opacity: 1 - p * 0.6 });
  }) as EventListener);
</script>
