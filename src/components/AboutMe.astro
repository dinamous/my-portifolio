---

<section
  class="aboutme fixed inset-0 h-screen w-screen"
  id="aboutme-section"
  data-stack
>
  <div class="aboutme__block aboutme__block--top" id="aboutme-block-top"></div>
  <div class="aboutme__block aboutme__block--bottom" id="aboutme-block-bottom"></div>
</section>

<style>
  .aboutme {
    display: flex;
    flex-direction: column;
    pointer-events: none;
    /* transparent: only the two blocks below should ever be visible. sectionStack
       assigns the last section the lowest z-index (reveal-from-behind default);
       this section instead curtains its own blocks over whatever's on top, so it
       needs to sit above Hero/WhatIDo the whole time without hiding them itself. */
    z-index: 20 !important;
  }

  .aboutme__block {
    width: 100%;
    height: 50dvh;
    background: #000;
    will-change: transform;
  }
</style>

<script>
  import gsap from "gsap";

  const blockTop = document.getElementById("aboutme-block-top")!;
  const blockBottom = document.getElementById("aboutme-block-bottom")!;

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (reduceMotion) {
    gsap.set([blockTop, blockBottom], { xPercent: 0 });
  } else {
    gsap.set(blockTop, { xPercent: -100 });
    gsap.set(blockBottom, { xPercent: 100 });

    // curtains straight over whatever's on top as WhatIDo's own scroll segment
    // progresses — no reliance on WhatIDo's clip-path closing (it's opted out via
    // data-no-close-clip), just this section's own reveal. Starts at the 2/3 mark
    // (after WhatIDo's dead-zone + text-blur, see WhatIDo.astro — keep in sync)
    // and slides in over a quick 0.2 stretch instead of dragging out the rest.
    window.addEventListener("whatido:progress", ((e: CustomEvent<{ progress: number }>) => {
      const t = e.detail.progress;
      const slideT = gsap.utils.clamp(0, 1, (t - 2 / 3) / 0.2);
      gsap.set(blockTop, { xPercent: gsap.utils.interpolate(-100, 0, slideT) });
      gsap.set(blockBottom, { xPercent: gsap.utils.interpolate(100, 0, slideT) });
    }) as EventListener);
  }
</script>
